# ── Web app only ────────────────────────────────────────────────────────────
# The Claude Code plugin needs NONE of these: it authorizes the Zapier MCP
# connector in your client and uses Claude itself as the model.

# Zapier MCP — the single integration surface. One server exposes Google
# Workspace Admin, BambooHR, Gmail, Google Chat (and anything else you add).
# mcp.zapier.com -> your MCP server -> Connect -> copy the URL and token.
ZAPIER_MCP_URL=https://mcp.zapier.com/api/v1/connect
ZAPIER_MCP_TOKEN=

# Anthropic powers the app's own agent. console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Claude model. Haiku 4.5 is fast and cheap; claude-sonnet-5 for harder work.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Identity ────────────────────────────────────────────────────────────────
# Your Google Workspace primary domain. Used to sanity-check account emails
# before anything is provisioned against them.
WORKSPACE_DOMAIN=

# Who this app acts as. Every audit entry and every approval decision is
# attributed to this address, so it must be a real person while there is no
# sign-in. Replace with your authenticated user in production.
OPERATOR_EMAIL=

# Confirmation password for anything that changes access — approving a grant,
# revoking, offboarding, applying a review's revokes, or hand-marking a row
# revoked. Typed into a dialog and checked on the server.
#
# This is a seatbelt against a misclick, NOT authentication: one shared secret
# cannot tell two people apart, is not recorded in the audit trail, and is
# readable by anyone who can read this file. Put real auth in front of the app
# before it leaves your machine.
#
# Leaving it blank does not disable the guard — it blocks those actions
# outright, because a guard that silently switches itself off is worse than
# none.
ACTION_PASSWORD=

# ── Register storage ────────────────────────────────────────────────────────
# Where the register lives: the catalogue, entitlements, requests, reviews and
# the audit trail.
#
# Leave both blank and it uses .data/*.json on this machine — fine for one
# person, invisible to anything else.
#
# Set them and it uses Supabase instead, which is what lets a Claude session
# with the Supabase connector read and write the SAME register this app does.
# That is the point: one store, no copies to fall out of step.
#
# Run supabase/schema.sql once in the SQL editor before first use.
# Dashboard -> Project Settings -> Data API for the URL,
# and -> API Keys for the service_role key.
#
# SERVICE ROLE, not anon: it bypasses row level security, so it must stay
# server-side. Never put it in NEXT_PUBLIC_ anything.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
